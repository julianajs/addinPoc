# Configuração do Add-in Outlook

# URL do fluxo Power Automate
# Obtenha em: Power Automate > Seu Fluxo > Acionador > URL HTTP POST
POWER_AUTOMATE_URL=https://prod-xx.brazilsouth.logic.azure.com:443/workflows/xxxxx/triggers/manual/paths/invoke?api-version=2016-06-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=xxxxx

# Ambiente (development, staging, production)
NODE_ENV=development

# Porta do servidor local
PORT=3000

# Hostname
HOSTNAME=localhost

# Usar HTTPS
USE_HTTPS=true

# Chave de autenticação (opcional, para maior segurança)
AUTH_KEY=sua-chave-de-autenticacao-aqui

# Email de suporte
SUPPORT_EMAIL=suporte@example.com

# Enabled features
FEATURE_EMAIL_CONFIRMATION=true
FEATURE_EXCEL_LOGGING=true
FEATURE_TEAMS_NOTIFICATION=false

# Timeout para requisições (em ms)
REQUEST_TIMEOUT=30000

# URL base do add-in (para testesfora)
ADD_IN_BASE_URL=https://localhost:3000

# ID da Aplicação (se usar Azure AD)
AZURE_APP_ID=00000000-0000-0000-0000-000000000000

# ID do Tenant do Azure
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
