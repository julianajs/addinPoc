<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="MailAppType">
  <Id>12345678-1234-1234-1234-123456789012</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Add-in Classificação de Reunião</ProviderName>
  <DefaultLocale>pt-BR</DefaultLocale>
  
  <DisplayName DefaultValue="Marcar Reunião Pública"/>
  <Description DefaultValue="Marca uma reunião como pública para monitoramento através do Power Automate"/>
  
  <Hosts>
    <Host xsi:type="MailHost">
      <DesktopFormFactor>
        <FunctionFile resid="functionfile"/>
        <ExtensionPoint xsi:type="MessageReadCommandSurface">
          <OfficeTab id="TabDefault">
            <Group id="msgreadgroup">
              <Label resid="groupLabel"/>
              <Control xsi:type="Button" id="msgreadbutton">
                <Label resid="buttonLabel"/>
                <Supertip>
                  <Title resid="buttonTitle"/>
                  <Description resid="buttonDesc"/>
                </Supertip>
                <Icon>
                  <bt:Image size="16" resid="icon16"/>
                  <bt:Image size="32" resid="icon32"/>
                  <bt:Image size="80" resid="icon80"/>
                </Icon>
                <Action xsi:type="ShowTaskPane">
                  <SourceLocation resid="taskpaneUrl"/>
                </Action>
              </Control>
            </Group>
          </OfficeTab>
        </ExtensionPoint>
      </DesktopFormFactor>
      
      <MobileFormFactor>
        <FunctionFile resid="functionfile"/>
        <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
          <Control xsi:type="MobileButton" id="mobilebutton">
            <Label resid="buttonLabel"/>
            <Icon>
              <bt:Image size="25" resid="icon25"/>
              <bt:Image size="32" resid="icon32"/>
            </Icon>
            <Action xsi:type="ShowTaskPane">
              <SourceLocation resid="taskpaneUrl"/>
            </Action>
          </Control>
        </ExtensionPoint>
      </MobileFormFactor>
    </Host>
  </Hosts>
  
  <Resources>
    <bt:Images>
      <bt:Image id="icon16" DefaultValue="https://localhost:3000/icons/red-flag-16.png"/>
      <bt:Image id="icon25" DefaultValue="https://localhost:3000/icons/red-flag-25.png"/>
      <bt:Image id="icon32" DefaultValue="https://localhost:3000/icons/red-flag-32.png"/>
      <bt:Image id="icon80" DefaultValue="https://localhost:3000/icons/red-flag-80.png"/>
    </bt:Images>
    <bt:Urls>
      <bt:Url id="functionfile" DefaultValue="https://localhost:3000/function-file/function-file.html"/>
      <bt:Url id="taskpaneUrl" DefaultValue="https://localhost:3000/taskpane.html"/>
    </bt:Urls>
    <bt:ShortStrings>
      <bt:String id="groupLabel" DefaultValue="Monitoramento"/>
      <bt:String id="buttonLabel" DefaultValue="Marcar Reunião Pública"/>
      <bt:String id="buttonTitle" DefaultValue="Marcar Reunião como Pública"/>
    </bt:ShortStrings>
    <bt:LongStrings>
      <bt:String id="buttonDesc" DefaultValue="Marca a reunião atual como pública para monitoramento no Power Automate"/>
    </bt:LongStrings>
  </Resources>
  
  <Permissions>ReadWriteMailbox</Permissions>
</OfficeApp>
