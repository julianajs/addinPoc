<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Identificação básica -->
  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Monitorar Reunião Pública</ProviderName>
  <DefaultLocale>pt-BR</DefaultLocale>
  <DisplayName DefaultValue="Monitorar Reunião Pública"/>
  <Description DefaultValue="Envia informações da reunião ao fluxo do Power Automate para monitoramento."/>

  <!-- Ícones - arquivo SVG local -->
  <IconUrl DefaultValue="icon.svg"/>
  <HighResolutionIconUrl DefaultValue="icon.svg"/>

  <SupportUrl DefaultValue="https://kind-dune-04677490f.7.azurestaticapps.net"/>

  <!-- Suporte de hosts: Outlook -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Requisitos mínimos da API -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <!-- Formulário de leitura padrão (fallback) -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://kind-dune-04677490f.7.azurestaticapps.net/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissões -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Regra de ativação: apenas em eventos de calendário -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>

  <!-- Versões avançadas - botão na faixa de opções -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">

        <!-- Modo de leitura de compromissos -->
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <!-- Botão direto na faixa de opções (não agrupado) -->
                <Control xsi:type="Button" id="MonitorarReuniaoBtn">
                  <Label resid="BtnLabel"/>
                  <Supertip>
                    <Title resid="BtnLabel"/>
                    <Description resid="BtnDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Modo de leitura de compromissos (participante) -->
          <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroupAttendee">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="MonitorarReuniaoAttendeeBtn">
                  <Label resid="BtnLabel"/>
                  <Supertip>
                    <Title resid="BtnLabel"/>
                    <Description resid="BtnDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Recursos centralizados -->
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="icon.svg"/>
        <bt:Image id="Icon32" DefaultValue="icon.svg"/>
        <bt:Image id="Icon80" DefaultValue="icon.svg"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Monitoramento"/>
        <bt:String id="BtnLabel" DefaultValue="Monitorar Reunião"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="BtnDesc" DefaultValue="Abre o painel para enviar os dados desta reunião ao fluxo de monitoramento no Power Automate."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
